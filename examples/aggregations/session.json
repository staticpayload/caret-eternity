{
  "name": "Session Window Aggregation",
  "description": "Aggregates values in activity-based sessions",
  "nodes": [
    {
      "id": "source",
      "type": "generator",
      "config": {
        "interval_ms": 100,
        "min": 1,
        "max": 10
      }
    },
    {
      "id": "session_count",
      "type": "aggregate",
      "config": {
        "function": "count",
        "window": "session(2s)",
        "emit": "end"
      }
    },
    {
      "id": "output",
      "type": "console",
      "config": {
        "prefix": "Session Count: "
      }
    }
  ],
  "edges": [
    {
      "from": "source",
      "to": "session_count"
    },
    {
      "from": "session_count",
      "to": "output"
    }
  ]
}
